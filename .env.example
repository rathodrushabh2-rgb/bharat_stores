# Neon Postgres connection string (pooled)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
# Optional: long random string used to sign login cookies (openssl rand -hex 32).
# If empty, a key is derived from DATABASE_URL.
SESSION_SECRET=
# Optional: WhatsApp Business Cloud API webhook
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
